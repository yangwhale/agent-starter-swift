<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- 锁屏 / 灵动岛实时活动（扩展 CloseCrabActivity）。Apple 要求宿主 app 声明这一条
	     才允许开实时活动；漏了的话锁屏上什么都不出（不是崩溃，也不一定有日志）。
	     macOS / visionOS 上这个键无效。 -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 手写体。Xcode 的资源拷贝会把 Resources/Fonts/ 里的文件打平到包根目录，
	     所以这里写文件名不写路径。万一某个 Xcode 版本保留了子目录，
	     CCHandFont.bootstrap() 会在运行时自己找到并注册，不会静默失效。 -->
	<key>UIAppFonts</key>
	<array>
		<string>PatrickHand-Regular.ttf</string>
	</array>
</dict>
</plist>
